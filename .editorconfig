# EditorConfig for M3U8 Download Manager
# https://editorconfig.org

# 默认设置（所有文件）
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell 脚本
[*.ps1]
indent_style = space
indent_size = 4
max_line_length = 120

# PowerShell 模块
[*.psm1]
indent_style = space
indent_size = 4
max_line_length = 120

# PowerShell 数据文件
[*.psd1]
indent_style = space
indent_size = 4

# JSON 配置文件
[*.json]
indent_style = space
indent_size = 2

# Markdown 文档
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# 批处理文件
[*.{bat,cmd}]
end_of_line = crlf

# Shell 脚本（如果在 Windows 上使用 Git Bash 等）
[*.sh]
end_of_line = lf
charset = utf-8
